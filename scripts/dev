#!/usr/bin/env bash
# Run the heavy/JVM path (bridge build, upstream mage build, reference XMage server) in containers.
# Android :app builds run on the host, not through this. See docs/build-environment.md.
#
# Usage (from the repo root):
#   ./scripts/dev gradle <args>    # e.g. ./scripts/dev gradle :bridge:check
#   ./scripts/dev mvn <args>       # maven inside the build container
#   ./scripts/dev build <service>  # e.g. ./scripts/dev build bridge      (rebuild an image)
#   ./scripts/dev up <service>     # e.g. ./scripts/dev up xmage-server
#   ./scripts/dev down
#   ./scripts/dev sh               # interactive shell in the build container
set -euo pipefail

# Without this, BuildKit's default provenance/SBOM attestations embed a build timestamp, so every
# image gets a new ID on every rebuild even when every layer is a cache hit. `build`'s image is a
# FROM base for server/Dockerfile and bridge/Dockerfile, so that churn busts their cache too,
# forcing their multi-minute upstream-mage clone+install to redo for no real reason. Confirmed by
# rebuilding twice and diffing `docker image inspect --format '{{.Id}}'` — this env var was the
# only thing (of several tried, incl. the compose-level provenance/sbom: false fields) that
# actually kept the ID stable.
export BUILDX_NO_DEFAULT_ATTESTATIONS=1

# Resolve the repo root so the script works from anywhere.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE=(docker compose -f "$ROOT/docker/docker-compose.yml")

cmd="${1:-}"
shift || true

# Forward opt-in env vars into the one-off container. XMAGE_SERVER gates the live integration test
# (ConnectAuthenticateIT): without this pass-through the documented command
# `XMAGE_SERVER=xmage-server:17171 ./scripts/dev gradle :bridge:test ...` would silently *skip* the
# test inside the container. `compose run` does not inherit the host env otherwise.
RUN_ENV=()
if [ -n "${XMAGE_SERVER:-}" ]; then
  RUN_ENV+=(-e "XMAGE_SERVER=$XMAGE_SERVER")
fi

case "$cmd" in
  gradle) exec "${COMPOSE[@]}" run --rm "${RUN_ENV[@]}" build sh ./gradlew "$@" ;;
  mvn)    exec "${COMPOSE[@]}" run --rm "${RUN_ENV[@]}" build mvn "$@" ;;
  build)
    if [ "$#" -eq 0 ]; then
      # No service named: build all of them, but sequentially and in dependency order rather than
      # via a single multi-target `compose build`. Compose's bake builder (default since Compose
      # v5) does not know that server/Dockerfile and bridge/Dockerfile's `FROM
      # mage-free-client/build:latest` is the `build` service's own image — building all three at
      # once, it tries to *pull* that tag from Docker Hub, gets `pull access denied` (the image
      # only exists locally), and cancels the other in-flight targets. Building `build` first,
      # then the others as separate single-target invocations, sidesteps this: by the time
      # xmage-server/bridge build, the base image already exists in the local Docker image store.
      "${COMPOSE[@]}" build build
      "${COMPOSE[@]}" build xmage-server
      exec "${COMPOSE[@]}" build bridge
    else
      exec "${COMPOSE[@]}" build "$@"
    fi
    ;;
  up)     exec "${COMPOSE[@]}" up -d "$@" ;;
  down)   exec "${COMPOSE[@]}" down "$@" ;;
  sh)     exec "${COMPOSE[@]}" run --rm "${RUN_ENV[@]}" build bash ;;
  *)
    echo "usage: ./scripts/dev {gradle|mvn|build|up|down|sh} ..." >&2
    exit 2
    ;;
esac
