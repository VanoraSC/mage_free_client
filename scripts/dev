#!/usr/bin/env bash
# Run the heavy/JVM path (bridge build, upstream mage build, reference XMage server) in containers.
# Android :app builds run on the host, not through this. See docs/build-environment.md.
#
# Usage (from the repo root):
#   ./scripts/dev gradle <args>    # e.g. ./scripts/dev gradle :bridge:check
#   ./scripts/dev mvn <args>       # maven inside the build container
#   ./scripts/dev build <service>  # e.g. ./scripts/dev build bridge      (rebuild an image)
#   ./scripts/dev up <service>     # e.g. ./scripts/dev up xmage-server   (added in story 0022)
#   ./scripts/dev down
#   ./scripts/dev sh               # interactive shell in the build container
set -euo pipefail

# Resolve the repo root so the script works from anywhere.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE=(docker compose -f "$ROOT/docker/docker-compose.yml")

cmd="${1:-}"
shift || true

# Forward opt-in env vars into the one-off container. XMAGE_SERVER gates the live integration test
# (story 0003's ConnectAuthenticateIT): without this pass-through the documented command
# `XMAGE_SERVER=xmage-server:17171 ./scripts/dev gradle :bridge:test ...` would silently *skip* the
# test inside the container. `compose run` does not inherit the host env otherwise.
RUN_ENV=()
if [ -n "${XMAGE_SERVER:-}" ]; then
  RUN_ENV+=(-e "XMAGE_SERVER=$XMAGE_SERVER")
fi

case "$cmd" in
  gradle) exec "${COMPOSE[@]}" run --rm "${RUN_ENV[@]}" build sh ./gradlew "$@" ;;
  mvn)    exec "${COMPOSE[@]}" run --rm "${RUN_ENV[@]}" build mvn "$@" ;;
  build)  exec "${COMPOSE[@]}" build "$@" ;;
  up)     exec "${COMPOSE[@]}" up -d "$@" ;;
  down)   exec "${COMPOSE[@]}" down "$@" ;;
  sh)     exec "${COMPOSE[@]}" run --rm "${RUN_ENV[@]}" build bash ;;
  *)
    echo "usage: ./scripts/dev {gradle|mvn|build|up|down|sh} ..." >&2
    exit 2
    ;;
esac
