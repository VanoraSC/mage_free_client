<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only cleartext allowance.

  `KtorBridgeClient` builds `ws://host:port/...` for a ServerTarget with `secure = false`, and the
  reference bridge is plain WebSocket (the emulator reaches the host bridge at 10.0.2.2:8080). The app
  targets SDK 36, where cleartext traffic is denied by default, so without this a device connect fails
  with "CLEARTEXT communication to 10.0.2.2 not permitted by network security policy" — the connect
  flow is mounted and reachable and *still* never produces a Connected state.

  Nothing below the UI catches this: a JVM integration test proving the client live against a real
  bridge has no Android network security policy at all.

  Scoped to the **debug** variant deliberately: release keeps the platform default, so a shipped build
  still requires `wss`. Whether release should ship a narrower `networkSecurityConfig` rather than
  requiring TLS outright is an open decision.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application android:usesCleartextTraffic="true"
        tools:ignore="UnusedAttribute" />

</manifest>
